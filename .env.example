# --- Source database: the live masterly Postgres to copy FROM (read access only) ---
# Local dev: masterly's dcl.yml publishes its Postgres on host port 2001,
# reachable from containers as host.docker.internal (extra_hosts maps it).
SOURCE_DB_HOST=host.docker.internal
SOURCE_DB_PORT=2001
SOURCE_DB_DATABASE=masterly
SOURCE_DB_USERNAME=laravel
SOURCE_DB_PASSWORD=

# --- Internal Postgres: this stack's own instance holding the snapshot copy ---
# Superuser of the internal instance (used by the sync job; published on host port 2010)
INTERNAL_DB_USERNAME=chatbot_admin
INTERNAL_DB_PASSWORD=

# Read-only role the chat app connects with (created/granted by the sync job)
CHATBOT_DB_PASSWORD=

# --- Sync ---
# Seconds between database copies (default: 1 hour)
SYNC_INTERVAL_SECONDS=3600

# --- Chat app ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Basic auth for the chat page (http://localhost:8080)
CHAT_USERNAME=admin
CHAT_PASSWORD=

# --- Source database: the live masterly Postgres to copy FROM (read access only) ---
# Local dev: masterly's dcl.yml publishes its Postgres on host port 2001,
# reachable from containers as host.docker.internal (extra_hosts maps it).
# Leave these alone (or empty) when seeding from a dump file instead.
SOURCE_DB_HOST=host.docker.internal
SOURCE_DB_PORT=2001
SOURCE_DB_DATABASE=masterly
SOURCE_DB_USERNAME=laravel
SOURCE_DB_PASSWORD=

# --- Seed from a dump file instead of a live source (optional) ---
# Path on the HOST (relative to this compose file) of a pg_dump backup — either
# a custom-format archive or plain SQL; the extension doesn't matter. When set,
# the sync job restores this file instead of dumping SOURCE_DB_*, and re-runs
# only when the file's mtime changes. Never commit the dump itself.
# SOURCE_DUMP_FILE=./masterly-backup.sql

# --- Internal Postgres: this stack's own instance holding the snapshot copy ---
# One server (published on host port 2010), three roles with deliberately
# different privileges. The passwords are NOT interchangeable — the split is the
# security boundary, so give each its own value.
#
#   ADMIN_*     superuser; only the sync job uses it (drops/recreates databases)
#   SNAPSHOT_*  SELECT-only; what the model's generated SQL runs as
#   HISTORY_*   read/write, but only over the chat-history database
#
# Host and port for all three are set in docker-compose.yml (the `db` service).

# Superuser — sync job only. Never give this one to the app.
ADMIN_DB_USERNAME=chatbot_admin
ADMIN_DB_PASSWORD=

# Read-only role the chat app queries the snapshot with. Created and re-granted
# by the sync job every cycle, since the grants die with the snapshot drop.
SNAPSHOT_DB_USERNAME=chatbot
SNAPSHOT_DB_PASSWORD=

# Saved chat history: its own database and read/write role on the same internal
# Postgres (created by the sync job, tables created by the app). It is kept out
# of masterly_snapshot because that database is dropped and recreated on every
# sync. Leave HISTORY_DB_PASSWORD empty to run without saved history.
HISTORY_DB_DATABASE=chatbot_app
HISTORY_DB_USERNAME=chatbot_app
HISTORY_DB_PASSWORD=

# --- Sync ---
# Seconds between database copies (default: 1 hour)
SYNC_INTERVAL_SECONDS=3600

# --- Chat app ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# The single account for the chat page's login form (http://localhost:8090).
CHAT_USERNAME=admin
CHAT_PASSWORD=

# Optional: key used to sign the session cookie. Left empty it is derived from
# CHAT_PASSWORD, so changing the password signs the session out. Set it to pin
# sessions across password changes (any long random string).
SESSION_SECRET=
